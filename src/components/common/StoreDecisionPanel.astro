---
import { formatComparisonValue, gameSignalLabels } from "../../lib/page-utils";
import type { GameEntry } from "../../types/page-props";

export interface Props {
  title: string;
  description?: string;
  games: GameEntry[];
  ctaLabel?: string;
  note?: string;
}

const {
  title,
  description,
  games,
  ctaLabel = "View official store page",
  note = "These buttons go to official store pages. CoopQueue does not currently use affiliate links on them."
} = Astro.props;

const displayGames = games.filter((game) => Boolean(game.data.officialUrl)).slice(0, 3);
---

{
  displayGames.length > 0 && (
    <section class="card store-decision-panel">
      <div class="eyebrow">Official Store Links</div>
      <h2>{title}</h2>
      {description && <p class="muted store-decision-copy">{description}</p>}

      <div class="store-decision-grid">
        {displayGames.map((game) => (
          <article class="store-decision-card">
            <div class="store-decision-head">
              <div>
                <div class="route-card-kicker">Quick buy signal</div>
                <strong>{game.data.name}</strong>
              </div>
              <span class="meta-chip">{game.data.players}</span>
            </div>

            <div class="game-card-signal-row">
              {gameSignalLabels(game).map((signal) => (
                <span class="game-card-signal">{signal}</span>
              ))}
              <span class="game-card-signal">{formatComparisonValue(game, "onboarding")} onboarding</span>
            </div>

            <p class="muted store-decision-pitch">{game.data.shortPitch}</p>

            <a
              class="store-decision-button"
              href={game.data.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {ctaLabel}
            </a>
          </article>
        ))}
      </div>

      <p class="muted store-decision-note">{note}</p>
    </section>
  )
}

<style>
  .store-decision-panel {
    display: grid;
    gap: 16px;
  }

  .store-decision-copy,
  .store-decision-note,
  .store-decision-pitch {
    margin: 0;
  }

  .store-decision-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .store-decision-card {
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.62));
    box-shadow: var(--shadow-soft);
    display: grid;
    gap: 12px;
  }

  .store-decision-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
  }

  .store-decision-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid rgba(15, 40, 98, 0.14);
    text-decoration: none;
    font-weight: 700;
    background: linear-gradient(
      135deg,
      rgba(81, 208, 222, 0.2),
      rgba(190, 239, 0, 0.16)
    );
    color: var(--accent-deep);
    box-shadow: 0 10px 20px rgba(15, 40, 98, 0.08);
  }

  .store-decision-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 24px rgba(15, 40, 98, 0.11);
  }

  .store-decision-note {
    font-size: 0.92rem;
  }
</style>
